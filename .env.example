# Required: OpenAI is the only wired-up provider in this MVP.
OPENAI_API_KEY=sk-...

# Model used by each role. gpt-5-mini for planning (better reasoning for
# task decomposition), gpt-5-nano for the high-volume specialist tool loops
# and reviewer calls (cheapest per-token, called many times per task).
SUPERVISOR_MODEL=gpt-5-mini
SPECIALIST_MODEL=gpt-5-nano
REVIEWER_MODEL=gpt-5-nano

# Anthropic is stubbed behind the same provider interface (src/orchestration/llm/provider.py)
# but not implemented yet. Set this and flip PROVIDER=anthropic once it is.
# ANTHROPIC_API_KEY=sk-ant-...
PROVIDER=openai

# Escalation thresholds (see src/orchestration/hitl/escalation.py)
CONFIDENCE_THRESHOLD=0.6
REVIEW_SCORE_THRESHOLD=0.6
MAX_SPECIALIST_RETRIES=2

# SQLite file used for working memory, traces, and the approval queue.
SQLITE_PATH=data/orchestration.db

# Separate SQLite file for the LangGraph checkpointer (execution state that
# powers pause/resume for human-in-the-loop). Kept separate from the main
# DB so graph internals don't collide with the application schema.
CHECKPOINT_PATH=data/checkpoints.db

# ChromaDB persistent directory (long-term semantic memory).
CHROMA_PATH=data/chroma

# Sandbox root that file_read/file_write/code_exec tools are jailed to.
WORKDIR=workdir
